<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Daily summary generation (runs at end of day) -->
    <record id="ir_cron_daily_summary" model="ir.cron">
        <field name="name">EDI: Generate daily summary</field>
        <field name="model_id" ref="model_l10n_py_edi_summary" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_daily_summary()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Daily summary email (runs once per day) -->
    <record id="ir_cron_daily_summary_email" model="ir.cron">
        <field name="name">EDI: Send daily summary email</field>
        <field name="model_id" ref="model_l10n_py_edi_summary" />
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_summary_email()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
