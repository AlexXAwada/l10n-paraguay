<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        EDI Summary Report - placeholder for future Excel/PDF export
        This file defines the report structure for EDI summaries.
    -->
    <report
        id="action_edi_summary_report"
        string="EDI Summary"
        model="l10n_py.edi.dashboard"
        report_type="qweb-pdf"
        name="l10n_py_edi_dashboard.report_edi_summary_template"
        file="l10n_py_edi_dashboard/report/edi_summary"
    />

    <!-- Report template (placeholder) -->
    <template id="report_edi_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h1>EDI Summary</h1>
                </div>
            </t>
        </t>
    </template>
</odoo>
