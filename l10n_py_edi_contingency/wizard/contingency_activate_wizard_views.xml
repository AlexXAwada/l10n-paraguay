<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Wizard form view -->
    <record id="view_l10n_py_contingency_activate_wizard_form" model="ir.ui.view">
        <field name="name">l10n_py.contingency.activate.wizard.form</field>
        <field name="model">l10n_py.contingency.activate.wizard</field>
        <field name="arch" type="xml">
            <form string="Activate Contingency Mode">
                <group>
                    <group>
                        <field
                            name="booklet_id"
                            options="{'no_open': True, 'no_create': True}"
                        />
                    </group>
                    <group>
                        <p class="text-muted">
                            Select the physical booklet from SET that will be
                            used to number these invoices. Each invoice will be
                            assigned the next available number from the booklet.
                        </p>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_activate"
                        string="Activate Contingency"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record
        id="action_l10n_py_contingency_activate_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Activate Contingency Mode</field>
        <field name="res_model">l10n_py.contingency.activate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
