<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Sync contingency documents when connection is restored -->
    <record id="ir_cron_sync_contingency_documents" model="ir.cron">
        <field name="name">EDI: Sync Contingency Documents to SIFEN</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="code">model._cron_sync_contingency_documents()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
