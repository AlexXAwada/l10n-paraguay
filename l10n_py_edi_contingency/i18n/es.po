#. module: l10n_py_edi_contingency
msgid "EDI Contingency Mode"
msgstr "Modo de Contingencia EDI"

#. module: l10n_py_edi_contingency
msgid "Offline contingency mode for EDI with physical booklets"
msgstr "Modo de contingencia sin conexión para EDI con cuadernillos físicos"

#. module: l10n_py_edi_contingency
msgid "Contingency Booklet (SET physical booklet)"
msgstr "Cuadernillo de Contingencia (cuadernillo físico SET)"

#. module: l10n_py_edi_contingency
msgid "Booklet Number"
msgstr "Número de Cuadernillo"

#. module: l10n_py_edi_contingency
msgid "Physical booklet number from SET"
msgstr "Número de cuadernillo físico de SET"

#. module: l10n_py_edi_contingency
msgid "Company"
msgstr "Empresa"

#. module: l10n_py_edi_contingency
msgid "Start Number"
msgstr "Número Inicial"

#. module: l10n_py_edi_contingency
msgid "First document number in this booklet"
msgstr "Primer número de documento en este cuadernillo"

#. module: l10n_py_edi_contingency
msgid "End Number"
msgstr "Número Final"

#. module: l10n_py_edi_contingency
msgid "Last document number in this booklet"
msgstr "Último número de documento en este cuadernillo"

#. module: l10n_py_edi_contingency
msgid "Used"
msgstr "Usados"

#. module: l10n_py_edi_contingency
msgid "Remaining"
msgstr "Restantes"

#. module: l10n_py_edi_contingency
msgid "Active"
msgstr "Activo"

#. module: l10n_py_edi_contingency
msgid "Exhausted"
msgstr "Agotado"

#. module: l10n_py_edi_contingency
msgid "Cancelled"
msgstr "Cancelado"

#. module: l10n_py_edi_contingency
msgid "Activation Date"
msgstr "Fecha de Activación"

#. module: l10n_py_edi_contingency
msgid "Date when this booklet started being used"
msgstr "Fecha cuando este cuadernillo comenzó a utilizarse"

#. module: l10n_py_edi_contingency
msgid "Notes"
msgstr "Notas"

#. module: l10n_py_edi_contingency
msgid "A booklet with this number already exists for this company."
msgstr "Ya existe un cuadernillo con este número para esta empresa."

#. module: l10n_py_edi_contingency
msgid "End number must be greater than or equal to start number."
msgstr "El número final debe ser mayor o igual al número inicial."

#. module: l10n_py_edi_contingency
msgid "Booklet %(booklet)s has no remaining numbers. Please activate a new booklet."
msgstr "El cuadernillo %(booklet)s no tiene números restantes. Por favor active un nuevo cuadernillo."

#. module: l10n_py_edi_contingency
msgid "Booklet %(booklet)s range exhausted. Next number (%(next)s) exceeds end number (%(end)s)."
msgstr "Rango del cuadernillo %(booklet)s agotado. El siguiente número (%(next)s) excede el número final (%(end)s)."

#. module: l10n_py_edi_contingency
msgid "Cannot activate an exhausted booklet."
msgstr "No se puede activar un cuadernillo agotado."

#. module: l10n_py_edi_contingency
msgid "Cannot cancel an active booklet with used numbers. Please exhaust it first or deactivate all invoices."
msgstr "No se puede cancelar un cuadernillo activo con números usados. Por favor agótelo primero o desactive todas las facturas."

#. module: l10n_py_edi_contingency
msgid "Invalid Range"
msgstr "Rango Inválido"

#. module: l10n_py_edi_contingency

#. module: l10n_py_edi_contingency
msgid "Contingency Booklet"
msgstr "Cuadernillo de Contingencia"

#. module: l10n_py_edi_contingency
msgid "Physical booklet used for this contingency document"
msgstr "Cuadernillo físico utilizado para este documento de contingencia"

#. module: l10n_py_edi_contingency
msgid "Contingency Number"
msgstr "Número de Contingencia"

#. module: l10n_py_edi_contingency
msgid "Document number from physical booklet (assigned in contingency mode)"
msgstr "Número de documento del cuadernillo físico (asignado en modo contingencia)"

#. module: l10n_py_edi_contingency
msgid "Contingency Mode"
msgstr "Modo Contingencia"

#. module: l10n_py_edi_contingency
msgid "True when this document uses contingency mode (no SIFEN connection)"
msgstr "Verdadero cuando este documento usa modo contingencia (sin conexión a SIFEN)"

#. module: l10n_py_edi_contingency
msgid "Activate contingency mode for invoices"
msgstr "Activar modo contingencia para facturas"

#. module: l10n_py_edi_contingency
msgid "Booklet"
msgstr "Cuadernillo"

#. module: l10n_py_edi_contingency
msgid "Select an active booklet with available numbers"
msgstr "Seleccione un cuadernillo activo con números disponibles"

#. module: l10n_py_edi_contingency
msgid "Please select a booklet"
msgstr "Por favor seleccione un cuadernillo"

#. module: l10n_py_edi_contingency
msgid "Booklet %(booklet)s has no remaining numbers. Please select a different booklet."
msgstr "El cuadernillo %(booklet)s no tiene números restantes. Por favor seleccione otro cuadernillo."

#. module: l10n_py_edi_contingency
msgid "No invoices selected"
msgstr "No hay facturas seleccionadas"

#. module: l10n_py_edi_contingency
msgid "No valid invoices found. Invoices must be in draft or pending status with no CDC assigned."
msgstr "No se encontraron facturas válidas. Las facturas deben estar en estado borrador o pendiente sin CDC asignado."

#. module: l10n_py_edi_contingency
msgid "Booklet %(booklet)s exhausted after activating %(count)s invoices."
msgstr "Cuadernillo %(booklet)s agotado después de activar %(count)s facturas."

#. module: l10n_py_edi_contingency
msgid "Contingency Mode Activated"
msgstr "Modo Contingencia Activado"

#. module: l10n_py_edi_contingency
msgid "%(count)s invoice(s) activated with contingency booklet %(booklet)s."
msgstr "%(count)s factura(s) activada(s) con cuadernillo de contingencia %(booklet)s."

#. module: l10n_py_edi_contingency
msgid "Contingency Booklets"
msgstr "Cuadernillos de Contingencia"

#. module: l10n_py_edi_contingency
msgid "Activate Contingency Mode"
msgstr "Activar Modo Contingencia"

#. module: l10n_py_edi_contingency
msgid "EDI: Sync Contingency Documents to SIFEN"
msgstr "EDI: Sincronizar Documentos de Contingencia a SIFEN"

#. module: l10n_py_edi_contingency
msgid "Sync contingency documents when connection is restored"
msgstr "Sincronizar documentos de contingencia cuando se restaure la conexión"

#. module: l10n_py_edi_contingency
msgid "Check for contingency documents and sync to SIFEN when connection is restored."
msgstr "Buscar documentos de contingencia y sincronizar a SIFEN cuando se restaure la conexión."