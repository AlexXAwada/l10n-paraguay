msgstr "Display Name"

msgid "The establishment code must contain exactly 3 digits."
msgstr "El código de establecimiento debe contener exactamente 3 dígitos."

msgid "The expedition point code must contain exactly 3 digits."
msgstr "El código de punto de expedición debe contener exactamente 3 dígitos."

msgid "The establishment must be numeric"
msgstr "El establecimiento debe ser numérico"

msgid "The establishment must have 3 digits"
msgstr "El establecimiento debe tener 3 dígitos"

msgid "\nNumber %(number)s is outside the authorized range (%(from)s - %(to)s)."
msgstr "\nEl número %(number)s está fuera del rango autorizado (%(from)s - %(to)s)."

msgid "\nNumber %(number)s has already been used in invoice %(invoice_name)s."
msgstr "\nEl número %(number)s ya ha sido utilizado en la factura %(invoice_name)s."

msgid "The invoice number must be unique per authorization."
msgstr "El número de factura debe ser único por timbrado."

msgid "The authorization number must contain exactly 8 numeric digits."
msgstr "El número de timbrado debe contener exactamente 8 dígitos numéricos."

msgid "The end number must be greater than the start number."
msgstr "El número final debe ser mayor al número inicial."

msgid "The end number cannot exceed %(max)s."
msgstr "El número final no puede exceder %(max)s."

msgid "The start number must be greater than zero."
msgstr "El número inicial debe ser mayor a cero."

msgid "The expedition point must be numeric"
msgstr "El punto de expedición debe ser numérico"

msgid "The expedition point must have 3 digits"
msgstr "El punto de expedición debe tener 3 dígitos"

msgid "The authorization is not yet effective."
msgstr "El timbrado aún no ha entrado en vigencia."

msgid "The authorization is inactive."
msgstr "El timbrado está inactivo."

msgid "The authorization has expired."
msgstr "El timbrado ha vencido."

msgid "\nThe selected authorization does not match the establishment and expedition point configured in the journal."
msgstr "\nEl timbrado seleccionado no corresponde al establecimiento y punto de \nexpedición configurados en el diario."

