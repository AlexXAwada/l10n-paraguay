<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Vista de formulario para account.authorization -->
    <record id="view_account_authorization_form" model="ir.ui.view">
        <field name="name">account.authorization.form</field>
        <field name="model">account.authorization</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="valid,to_expire,expired"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="check_validity"
                            type="object"
                            string="Verify Validity"
                            class="oe_stat_button"
                            icon="fa-check-circle"
                        />
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Authorization Number" />
                        <h1>
                            <field name="name" placeholder="ej: 12345678" />
                        </h1>
                    </div>
                    <group>
                        <group name="main_info">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="l10n_latam_document_type_id" />
                            <field name="active" />
                        </group>
                        <group name="dates">
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                    </group>
                    <group string="Authorized Numbering">
                        <group>
                            <field name="establishment" />
                            <field name="expedition_point" />
                            <field name="series" />
                        </group>
                        <group>
                            <field name="invoice_number_from" />
                            <field name="invoice_number_to" />
                        </group>
                    </group>
                    <group string="Statistics" col="4">
                        <field name="next_number" />
                        <field name="used_numbers" />
                        <field name="remaining_numbers" />
                        <field name="usage_percentage" widget="progressbar" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista para account.authorization -->
    <record id="view_account_authorization_tree" model="ir.ui.view">
        <field name="name">account.authorization.tree</field>
        <field name="model">account.authorization</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state=='expired'"
                decoration-warning="state=='to_expire'"
                decoration-success="state=='valid'"
            >
                <field name="name" />
                <field name="establishment" />
                <field name="expedition_point" />
                <field name="series" optional="hide" />
                <field name="l10n_latam_document_type_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="invoice_number_from" />
                <field name="invoice_number_to" />
                <field name="next_number" />
                <field name="remaining_numbers" />
                <field name="usage_percentage" widget="progressbar" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-danger="state=='expired'"
                    decoration-warning="state=='to_expire'"
                    decoration-success="state=='valid'"
                />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Search view for account.authorization -->
    <record id="view_account_authorization_search" model="ir.ui.view">
        <field name="name">account.authorization.search</field>
        <field name="model">account.authorization</field>
        <field name="arch" type="xml">
            <search string="Buscar Authorizations">
                <field name="name" string="Authorization" />
                <field name="establishment" />
                <field name="expedition_point" />
                <field name="l10n_latam_document_type_id" />
                <filter
                    string="Valids"
                    name="valid"
                    domain="[('state', '=', 'valid')]"
                />
                <filter
                    string="Expiring Soon"
                    name="to_expire"
                    domain="[('state', '=', 'to_expire')]"
                />
                <filter
                    string="Expireds"
                    name="expired"
                    domain="[('state', '=', 'expired')]"
                />
                <separator />
                <filter
                    string="Actives"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Inactivos"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <field name="l10n_latam_document_type_id" />
                <separator />
                <filter
                    string="State"
                    name="group_state"
                    context="{'group_by': 'state'}"
                />
                <filter
                    string="Document Type"
                    name="group_type"
                    context="{'group_by': 'l10n_latam_document_type_id'}"
                />
                <filter
                    string="Establishment"
                    name="group_establishment"
                    context="{'group_by': 'establishment'}"
                />
            </search>
        </field>
    </record>

    <!-- Action for account.authorization -->
    <record id="action_account_authorization" model="ir.actions.act_window">
        <field name="name">Authorizations</field>
        <field name="res_model">account.authorization</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[(5, 0, {'view_mode': 'list', 'view_id': ref('view_account_authorization_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_authorization_form')})]"
        />
        <field
            name="context"
        >{'search_default_active': 1, 'search_default_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new authorization
            </p>
            <p>
                Authorizations are documents issued by SET - Paraguay Tax Authority
                for issuing invoices. Each authorization has a numbering range and specific validity dates.
            </p>
        </field>
    </record>

    <!-- Paraguay menu under Configuration -->
    <menuitem
        id="menu_l10n_py_config"
        name="Paraguay"
        parent="account.menu_finance_configuration"
        sequence="50"
    />

    <menuitem
        id="menu_account_authorization"
        name="Authorizations"
        parent="menu_l10n_py_config"
        action="action_account_authorization"
        sequence="10"
    />
</odoo>
