<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_picking_form_nre" model="ir.ui.view">
        <field name="name">stock.picking.form.nre</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="l10n_py_nre_id"
                    invisible="not l10n_py_nre_id"
                    readonly="1"
                />
                <field
                    name="l10n_py_nre_cdc"
                    invisible="not l10n_py_nre_cdc"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_tree_nre" model="ir.ui.view">
        <field name="name">stock.picking.tree.nre</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="l10n_py_nre_cdc" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
